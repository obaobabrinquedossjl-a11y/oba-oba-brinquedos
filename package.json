{
  "name": "oba-oba-brinquedos",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard de gestão da Oba Oba Brinquedos",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply oba-oba-brinquedos-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply oba-oba-brinquedos-db --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
